#!/usr/bin/env bash
set -euo pipefail

# Student-facing lifecycle wrapper for the fixed CS 6494 HW2 environment.
# Names, project, model revision, duration, nodes, and provisioning payload are
# intentionally fixed. The only variable input is the authenticated username.
project="cs6494hw2"
experiment="hw2lab"
model_revision="3e40e7e2675258f40379508f6c2b54d84acddc1e"
duration="8h"
bundle="/project/cs6494hw2/hw2-provision-v3"
ssh_root=""
key_root=""

cleanup() {
    [[ -z "$ssh_root" ]] || rm -rf "$ssh_root"
    [[ -z "$key_root" ]] || rm -rf "$key_root"
}
trap cleanup EXIT

usage() {
    cat <<'EOF'
usage: ./sphere/hw2-sphere COMMAND

Commands:
  create          Create, attach, and provision your fixed HW2 environment
  status          Show your realization, expiry, and XDC URL
  connect         Verify provisioning, then open your HW2 process-node shell
  check           Verify installed tools, identity, capture, and OpenPLC
  download-analysis [DESTINATION]
                  Download the generated CFG and dependency-analysis bundle
  download-run RUN_NAME [DESTINATION]
                  Download one evidence directory printed by a run command
  release [--yes] Release your XDC and realization

The wrapper derives resource names from `mrg whoami`. It accepts no topology,
host, address, program, or attack parameters.
EOF
}

require_tool() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "missing required local tool: $1" >&2
        exit 2
    }
}

require_tool mrg
require_tool python3

username="$(mrg --colorless whoami | tr -d '\r\n')"
if [[ ! "$username" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    echo "could not derive a safe SPHERE username from mrg whoami" >&2
    exit 2
fi
slug="$(printf '%s' "$username" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')"
if [[ -z "$slug" ]]; then
    echo "SPHERE username does not produce a usable resource name" >&2
    exit 2
fi

realization="hw2${slug}.${experiment}.${project}"
# SPHERE permits personal XDCs only in the authenticated user's personal
# project. The XDC can still attach to this course-project materialization.
xdc="hw2${slug}.${username}"

realization_json() {
    mrg --colorless show realization "$realization" --json 2>/dev/null
}

realization_exists() {
    realization_json >/dev/null
}

materialization_exists() {
    mrg --colorless list materializations --json | python3 -c '
import json, sys
target = sys.argv[1]
data = json.load(sys.stdin)
found = any(
    ".".join((item.get("rid", ""), item.get("eid", ""), item.get("pid", ""))) == target
    for item in data.get("summaries", [])
)
raise SystemExit(0 if found else 1)
' "$realization"
}

xdc_record() {
    mrg --colorless list xdcs --json | python3 -c '
import json, sys
target = sys.argv[1]
for item in json.load(sys.stdin).get("XDCs", []):
    if item.get("name") == target:
        print(json.dumps(item))
        raise SystemExit(0)
raise SystemExit(1)
' "$xdc"
}

exact_expiry() {
    realization_json | python3 -c '
import json, sys
print(json.load(sys.stdin)["result"]["realization"]["expires"])
'
}

attached_materialization() {
    xdc_record | python3 -c '
import json, sys
print(json.load(sys.stdin).get("materialization", ""))
'
}

prepare_ssh() {
    [[ -z "$ssh_root" ]] || return 0
    require_tool ssh
    local identity="$HOME/.ssh/merge_key"
    if [[ ! -r "$identity" || ! -r "$identity-cert.pub" ]]; then
        echo "SPHERE SSH certificate missing. Run mrg login $username again." >&2
        return 2
    fi
    ssh_root="$(mktemp -d /tmp/cs6494-hw2-ssh.XXXXXX)"
    python3 - "$ssh_root/config" "$username" "${xdc/./-}" "$identity" <<'PY'
import pathlib
import sys
config, user, xdc_host, identity = sys.argv[1:]
def quoted(value):
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'
known_hosts = str(pathlib.Path(identity).parent / 'known_hosts')
temporary_hosts = str(pathlib.Path(config).parent / 'known_hosts')
pathlib.Path(config).write_text(f'''Host hw2-jump
    HostName jump.sphere-testbed.net
    Port 2022
    StrictHostKeyChecking yes
Host hw2-xdc
    HostName {xdc_host}
    ProxyJump hw2-jump
Host controller process
    HostName %h
    ProxyJump hw2-xdc
    UserKnownHostsFile {quoted(temporary_hosts)}
Host *
    User {user}
    IdentityFile {quoted(identity)}
    CertificateFile {quoted(identity + '-cert.pub')}
    IdentitiesOnly yes
    BatchMode yes
    ConnectTimeout 30
    ServerAliveInterval 15
    ServerAliveCountMax 4
    StrictHostKeyChecking accept-new
    UserKnownHostsFile {quoted(known_hosts)} {quoted(temporary_hosts)}
''', encoding='utf-8')
PY
}

remote() {
    prepare_ssh || return $?
    ssh -T -F "$ssh_root/config" "$@"
}

bootstrap_access() {
    require_tool ssh-keygen

    key_root="$(mktemp -d /tmp/cs6494-hw2-key.XXXXXX)"
    ssh-keygen -q -t ed25519 -N '' -C cs6494-hw2-ansible -f "$key_root/key"

    mrg xdc scp upload "$key_root/key" "$xdc:/tmp/hw2-ansible-key"
    mrg xdc scp upload "$key_root/key.pub" "$xdc:/tmp/hw2-ansible-key.pub"

    local node
    for node in controller process; do
        mrg xdc scp upload -x "$xdc" "$key_root/key.pub" \
            "$node:/tmp/hw2-ansible-key.pub"
        remote "$node" 'bash -se' <<'REMOTE'
install -d -m 700 "$HOME/.ssh"
touch "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"
sed -i '/ cs6494-hw2-ansible$/d' "$HOME/.ssh/authorized_keys"
cat /tmp/hw2-ansible-key.pub >> "$HOME/.ssh/authorized_keys"
REMOTE
    done
}

provision() {
    local expires
    expires="$(exact_expiry)"
    remote hw2-xdc "bash -se -- '$bundle' '$realization' '$username' '$expires'" <<'REMOTE'
bundle="$1"
test -r "$bundle/ansible/provision.sh" || {
    echo "Course provisioning bundle is unavailable; report this to staff." >&2
    exit 2
}
timeout 1800 bash "$bundle/ansible/provision.sh" "$2" "$3" "$4"
REMOTE
}

show_status() {
    if ! realization_exists; then
        echo "No HW2 realization exists for $username."
        echo "Create it with: ./sphere/hw2-sphere create"
        return 1
    fi
    realization_json | python3 -c '
import json, sys
r = json.load(sys.stdin)["result"]["realization"]
print("realization: {}.{}.{}".format(r["id"], r["eid"], r["pid"]))
print("model:       {}".format(r["xhash"]))
print("expires:     {}".format(r["expires"]))
print("complete:    {}".format(str(r.get("complete", False)).lower()))
'
    if xdc_record >/dev/null; then
        xdc_record | python3 -c '
import json, sys
x = json.load(sys.stdin)
print("xdc:         {}".format(x["name"]))
print("xdc URL:     {}".format(x["url"]))
print("attached:    {}".format(x.get("materialization", "not attached")))
'
    else
        echo "xdc:         not created"
    fi
}

create_environment() {
    prepare_ssh
    require_tool ssh-keygen

    if realization_exists; then
        local existing_revision
        existing_revision="$(realization_json | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["realization"]["xhash"])')"
        if [[ "$existing_revision" != "$model_revision" ]]; then
            echo "existing realization uses unexpected model $existing_revision" >&2
            echo "release it before continuing" >&2
            exit 2
        fi
        echo "Reusing your existing fixed realization: $realization"
    else
        echo "Creating your fixed HW2 realization (duration: $duration)..."
        mrg --sync realize "$realization" revision "$model_revision" --duration "$duration"
    fi

    if materialization_exists; then
        echo "Materialization already exists."
    else
        echo "Materializing the two-node topology..."
        mrg --sync materialize "$realization"
    fi

    if xdc_record >/dev/null; then
        local attached
        attached="$(attached_materialization)"
        if [[ -n "$attached" && "$attached" != "$realization" ]]; then
            echo "$xdc is attached to unexpected materialization $attached" >&2
            exit 2
        fi
    else
        echo "Creating your private-access XDC..."
        mrg --sync new xdc "$xdc" --type personal --duration "$duration"
        if ! xdc_record >/dev/null; then
            echo "SPHERE did not create $xdc; contact course staff with this message" >&2
            exit 2
        fi
    fi

    if [[ "$(attached_materialization)" != "$realization" ]]; then
        echo "Attaching your XDC..."
        mrg --sync xdc attach "$xdc" "$realization"
    fi

    echo "Preparing short-lived deployment access..."
    bootstrap_access
    echo "Installing the fixed course environment. This can take several minutes..."
    provision
    check_environment

    echo
    echo "HW2 is ready."
    show_status
    echo
    echo "Next: ./sphere/hw2-sphere connect"
    echo "Then run: hw2-prepare"
}

connect_environment() {
    check_environment
    mrg xdc ssh -x "$xdc" process
}

check_environment() {
    require_ready_environment
    if [[ "$(attached_materialization)" != "$realization" ]]; then
        echo "HW2 XDC attachment is incomplete. Run: ./sphere/hw2-sphere create" >&2
        return 2
    fi
    if ! remote process "bash -se -- '$realization' '$username'" <<'REMOTE'
test -x /usr/local/bin/hw2-prepare && test -r /etc/profile.d/cs6494-hw2.sh || {
    echo "HW2 provisioning has not finished: helper or identity profile missing." >&2
    exit 2
}
source /etc/profile.d/cs6494-hw2.sh
test "$HW2_INSTANCE_ID" = "$1" && test "$HW2_ALLOCATION_ID" = "$2" || {
    echo "Prepared identity does not match your allocation; resume create." >&2
    exit 2
}
# Preflight checks writable evidence output too. Use the student's canonical
# copy, not the root-owned installed payload checked by Ansible.
hw2-prepare >/dev/null
cd "$HOME/cs6494-hw2/hw2"
python3 preflight.py --require-sphere
REMOTE
    then
        echo "HW2 is not ready. From your workstation, rerun ./sphere/hw2-sphere create." >&2
        echo "Keep existing files; do not install packages or release the allocation to repair setup." >&2
        return 2
    fi
}

require_ready_environment() {
    if ! materialization_exists || ! xdc_record >/dev/null; then
        echo "HW2 is not ready. Run: ./sphere/hw2-sphere create" >&2
        exit 2
    fi
}

download_tree() {
    local remote_path="$1"
    local destination="$2"
    if [[ -e "$destination" ]]; then
        echo "refusing to overwrite existing destination: $destination" >&2
        exit 2
    fi
    require_ready_environment
    local resolved
    resolved="$(remote process "bash -se -- '$remote_path'" <<'REMOTE'
matches=()
for root in cs6494-hw2/hw2 cs6494-hw2/labs/cps-tank/hw2 cs6494-fall2026-students/labs/cps-tank/hw2; do
    [[ ! -d "$HOME/$root/$1" ]] || matches+=("$root/$1")
done
if [[ ${#matches[@]} -ne 1 ]]; then
    echo "Expected one matching evidence directory; found ${#matches[@]}. Keep your files and report this to staff." >&2
    exit 2
fi
printf '%s\n' "${matches[0]}"
REMOTE
)"
    mrg xdc scp download -x "$xdc" -r "process:$resolved" "$destination"
    echo "Downloaded $remote_path to $destination"
}

download_analysis() {
    download_tree "runs/analysis" "${1:-./hw2-analysis}"
}

download_run() {
    local run_name="$1"
    local destination="${2:-./$run_name}"
    if [[ ! "$run_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "RUN_NAME must be the final directory name printed after 'evidence:'" >&2
        exit 2
    fi
    download_tree "runs/$run_name" "$destination"
}

release_environment() {
    local confirmed="${1:-}"
    if [[ "$confirmed" != "--yes" ]]; then
        echo "This releases only $realization and $xdc."
        printf 'Type RELEASE to continue: '
        read -r answer
        [[ "$answer" == "RELEASE" ]] || {
            echo "Release cancelled."
            exit 1
        }
    fi

    if xdc_record >/dev/null; then
        mrg xdc detach "$xdc" || true
        mrg delete xdc "$xdc"
    fi
    if materialization_exists; then
        mrg dematerialize "$realization"
    fi
    if realization_exists; then
        mrg relinquish "$realization"
    fi
    echo "Released $realization and $xdc."
}

command="${1:-}"
case "$command" in
    create)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        create_environment
        ;;
    status)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        show_status
        ;;
    connect)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        connect_environment
        ;;
    check)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        check_environment
        ;;
    download-analysis)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        download_analysis "${2:-}"
        ;;
    download-run)
        [[ $# -ge 2 && $# -le 3 ]] || { usage >&2; exit 2; }
        download_run "$2" "${3:-}"
        ;;
    release)
        [[ $# -le 2 ]] || { usage >&2; exit 2; }
        release_environment "${2:-}"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
